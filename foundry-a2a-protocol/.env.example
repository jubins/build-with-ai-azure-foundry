# Copy this file to .env and fill in your values.

# ── Foundry project ──────────────────────────────────────────────────────────
# Format: https://{resource-name}.services.ai.azure.com/api/projects/{project-name}
AZURE_EXISTING_AIPROJECT_ENDPOINT=

# The Prompt Agent that backs the specialist (name:version)
AZURE_EXISTING_AGENT_ID=helpful-ai-agent:1

# Model deployment used when the coordinator agent is created
AZURE_MODEL_DEPLOYMENT=gpt-4o-mini

# ── A2A wiring ───────────────────────────────────────────────────────────────
# Public base URL of the specialist A2A server.
# Local:  http://localhost:8001
# Azure:  https://<your-container-app>.azurecontainerapps.io
SPECIALIST_A2A_URL=http://localhost:8001

# Name of the coordinator agent created/updated in Foundry
COORDINATOR_AGENT_NAME=research-coordinator

# Port the specialist A2A server listens on locally
A2A_PORT=8001
