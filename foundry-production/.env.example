# Copy this file to .env and fill in your values.

# ── Foundry project ──────────────────────────────────────────────────────────
AZURE_EXISTING_AIPROJECT_ENDPOINT=
AZURE_EXISTING_AGENT_ID=helpful-ai-agent:1

# ── Azure resources the audit inspects ───────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# Application Insights resource connected to your Foundry project.
# Find it in: Foundry portal → your project → Observability.
APPLICATION_INSIGHTS_NAME=

# ── Production guardrails ────────────────────────────────────────────────────
# Never set this to true in production — it logs prompts and user messages.
ENABLE_CONTENT_RECORDING=false

# Fraction of traces exported: 0.1 = 10%. Defaults to 1.0 (100%) if unset.
OTEL_TRACE_SAMPLING_RATIO=0.1

# Hard cap on tokens generated per response — cost/runaway guardrail.
MAX_OUTPUT_TOKENS=1024

# ── Audit thresholds (what "pass" means) ─────────────────────────────────────
EXPECTED_RETENTION_DAYS=30
EXPECTED_SAMPLING_RATIO=0.1
